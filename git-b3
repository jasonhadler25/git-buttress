# CLI Entry Point
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-b3",
        description="Smuggle BLAKE3 Merkle hashes into standard Git commits and tags.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pc = sub.add_parser("commit", help="Create a BLAKE3-sealed Git commit")
    pc.add_argument("-m", "--message", help="Commit message")
    pc.add_argument("-a", "--all", action="store_true", help="Stage modified tracked files")
    pc.add_argument("--allow-empty", action="store_true", help="Allow empty commit")
    pc.add_argument(
        "-S", "--gpg-sign", nargs="?", const="", default=None, help="Sign commit (SSH or GPG)"
    )
    pc.add_argument("--no-gpg-sign", action="store_true", help="Disable commit signing")
    pc.set_defaults(func=cmd_commit)

    ps = sub.add_parser("seal-head", help="Idempotently seal HEAD in place (for post-commit hook)")
    ps.add_argument("--sign", action="store_true", help="Sign the sealed commit")
    ps.add_argument("-q", "--quiet", action="store_true", help="Suppress output")
    ps.set_defaults(func=cmd_seal_head)

    pt = sub.add_parser("tag", help="Create an annotated/signed tag with Blake3-Object trailer")
    pt.add_argument("name", help="Tag name")
    pt.add_argument("target", nargs="?", default="HEAD", help="Target revision (default: HEAD)")
    pt.add_argument("-m", "--message", default="", help="Tag message")
    pt.add_argument("-a", "--annotate", action="store_true", help="Create annotated tag (default)")
    pt.add_argument("-s", "--sign", action="store_true", help="Sign tag (SSH or GPG)")
    pt.add_argument("--no-sign", action="store_true", help="Disable tag signing")
    pt.add_argument("-u", "--local-user", default=None, help="Signing key override")
    pt.add_argument("-f", "--force", action="store_true", help="Overwrite existing tag")
    pt.set_defaults(func=cmd_tag)

    pv = sub.add_parser("verify", help="Verify BLAKE3 Merkle integrity of a revision and its history")
    pv.add_argument("rev", nargs="?", default="HEAD", help="Revision or tag to verify (default: HEAD)")
    pv.add_argument("--expect", default=None, help="Expected 64-hex BLAKE3 commit/object ID")
    pv.add_argument(
        "--require-signature",
        action="store_true",
        help="Also verify Git commit/tag cryptographic signature",
    )
    pv.add_argument(
        "--no-shallow", action="store_true", help="Fail if verification hits a shallow clone boundary"
    )
    pv.set_defaults(func=cmd_verify)

    pi = sub.add_parser("id", help="Print the 64-hex BLAKE3 ID of a Git commit, tree, or blob")
    pi.add_argument("rev", nargs="?", default="HEAD", help="Revision (default: HEAD)")
    pi.set_defaults(func=cmd_id)

    pl = sub.add_parser("log", help="Show commit log with BLAKE3 IDs and seal status")
    pl.add_argument("rev", nargs="?", default="HEAD", help="Starting revision (default: HEAD)")
    pl.add_argument("-n", "--count", type=int, default=15, help="Max commits to show")
    pl.set_defaults(func=cmd_log)

    ph = sub.add_parser("install-hook", help="Install a post-commit hook to seal plain `git commit`")
    ph.add_argument("--force", action="store_true", help="Overwrite existing post-commit hook")
    ph.set_defaults(func=cmd_install_hook)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    repo = GitRepo()
    try:
        return args.func(repo, args)
    except GitB3Error as exc:
        print(f"git-b3: error: {exc}", file=sys.stderr)
        return 1
    finally:
        repo.close()


if __name__ == "__main__":
    raise SystemExit(main())
