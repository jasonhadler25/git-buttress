# ---------------------------------------------------------------------------
# BLAKE3 implementation (native `blake3` if installed, else built-in pure Python)
# ---------------------------------------------------------------------------

try:
    import blake3 as _native_blake3  # type: ignore[import-not-found]
except ImportError:
    _native_blake3 = None

_B3_IV = (
    0x6A09E667,
    0xBB67AE85,
    0x3C6EF372,
    0xA54FF53A,
    0x510E527F,
    0x9B05688C,
    0x1F83D9AB,
    0x5BE0CD19,
)
_B3_PERM = (2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8)
_CHUNK_START = 1 << 0
_CHUNK_END = 1 << 1
_PARENT = 1 << 2
_ROOT = 1 << 3
_BLOCK_LEN = 64
_CHUNK_LEN = 1024


def _b3_compress(
    cv: tuple[int, ...],
    block_words: list[int],
    counter: int,
    block_len: int,
    flags: int,
) -> list[int]:
    s = [
        cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7],
        _B3_IV[0], _B3_IV[1], _B3_IV[2], _B3_IV[3],
        counter & 0xFFFFFFFF, (counter >> 32) & 0xFFFFFFFF,
        block_len, flags,
    ]
    m = block_words
    for r in range(7):
        # Column rounds
        for a, b, c, d, mx, my in (
            (0, 4, 8, 12, m[0], m[1]),
            (1, 5, 9, 13, m[2], m[3]),
            (2, 6, 10, 14, m[4], m[5]),
            (3, 7, 11, 15, m[6], m[7]),
            (0, 5, 10, 15, m[8], m[9]),
            (1, 6, 11, 12, m[10], m[11]),
            (2, 7, 8, 13, m[12], m[13]),
            (3, 4, 9, 14, m[14], m[15]),
        ):
            sa = (s[a] + s[b] + mx) & 0xFFFFFFFF
            sd = s[d] ^ sa
            sd = ((sd >> 16) | (sd << 16)) & 0xFFFFFFFF
            sc = (s[c] + sd) & 0xFFFFFFFF
            sb = s[b] ^ sc
            sb = ((sb >> 12) | (sb << 20)) & 0xFFFFFFFF
            sa = (sa + sb + my) & 0xFFFFFFFF
            sd = sd ^ sa
            sd = ((sd >> 8) | (sd << 24)) & 0xFFFFFFFF
            sc = (sc + sd) & 0xFFFFFFFF
            sb = sb ^ sc
            sb = ((sb >> 7) | (sb << 25)) & 0xFFFFFFFF
            s[a], s[b], s[c], s[d] = sa, sb, sc, sd
        if r != 6:
            m = [m[i] for i in _B3_PERM]
    return [s[i] ^ s[i + 8] for i in range(8)]


class _PureBlake3Output:
    __slots__ = ("input_cv", "block_words", "counter", "block_len", "flags")

    def __init__(
        self,
        input_cv: tuple[int, ...],
        block_words: list[int],
        counter: int,
        block_len: int,
        flags: int,
    ) -> None:
        self.input_cv = input_cv
        self.block_words = block_words
        self.counter = counter
        self.block_len = block_len
        self.flags = flags

    def chaining_value(self) -> tuple[int, ...]:
        return tuple(
            _b3_compress(
                self.input_cv, self.block_words, self.counter, self.block_len, self.flags
            )
        )

    def root_digest(self) -> bytes:
        words = _b3_compress(
            self.input_cv,
            self.block_words,
            0,
            self.block_len,
            self.flags | _ROOT,
        )
        return struct.pack("<8I", *words)


class _PureBlake3ChunkState:
    __slots__ = ("cv", "chunk_counter", "block", "blocks_compressed", "flags")

    def __init__(self, key_words: tuple[int, ...], chunk_counter: int, flags: int) -> None:
        self.cv = key_words
        self.chunk_counter = chunk_counter
        self.block = bytearray()
        self.blocks_compressed = 0
        self.flags = flags

    def length(self) -> int:
        return _BLOCK_LEN * self.blocks_compressed + len(self.block)

    def start_flag(self) -> int:
        return _CHUNK_START if self.blocks_compressed == 0 else 0

    def update(self, data: memoryview) -> None:
        pos = 0
        n = len(data)
        while pos < n:
            if len(self.block) == _BLOCK_LEN:
                words = list(struct.unpack("<16I", self.block))
                self.cv = tuple(
                    _b3_compress(
                        self.cv,
                        words,
                        self.chunk_counter,
                        _BLOCK_LEN,
                        self.flags | self.start_flag(),
                    )
                )
                self.blocks_compressed += 1
                self.block.clear()
            take = min(_BLOCK_LEN - len(self.block), n - pos)
            self.block.extend(data[pos : pos + take])
            pos += take

    def output(self) -> _PureBlake3Output:
        padded = bytes(self.block) + b"\x00" * (_BLOCK_LEN - len(self.block))
        words = list(struct.unpack("<16I", padded))
        return _PureBlake3Output(
            self.cv,
            words,
            self.chunk_counter,
            len(self.block),
            self.flags | self.start_flag() | _CHUNK_END,
        )


def _parent_output(
    left_cv: tuple[int, ...], right_cv: tuple[int, ...], key_words: tuple[int, ...], flags: int
) -> _PureBlake3Output:
    return _PureBlake3Output(key_words, list(left_cv) + list(right_cv), 0, _BLOCK_LEN, _PARENT | flags)


class PureBlake3Hasher:
    """Full C2SP-compliant pure-Python BLAKE3 hasher (unkeyed 256-bit mode)."""

    def __init__(self) -> None:
        self._chunk_state = _PureBlake3ChunkState(_B3_IV, 0, 0)
        self._cv_stack: list[tuple[int, ...]] = []

    def _add_chunk_cv(self, new_cv: tuple[int, ...], total_chunks: int) -> None:
        while (total_chunks & 1) == 0:
            new_cv = _parent_output(self._cv_stack.pop(), new_cv, _B3_IV, 0).chaining_value()
            total_chunks >>= 1
        self._cv_stack.append(new_cv)

    def update(self, data: bytes | bytearray | memoryview) -> None:
        view = memoryview(data)
        pos = 0
        n = len(view)
        while pos < n:
            if self._chunk_state.length() == _CHUNK_LEN:
                chunk_cv = self._chunk_state.output().chaining_value()
                total_chunks = self._chunk_state.chunk_counter + 1
                self._add_chunk_cv(chunk_cv, total_chunks)
                self._chunk_state = _PureBlake3ChunkState(_B3_IV, total_chunks, 0)
            take = min(_CHUNK_LEN - self._chunk_state.length(), n - pos)
            self._chunk_state.update(view[pos : pos + take])
            pos += take

    def digest(self) -> bytes:
        output = self._chunk_state.output()
        for parent_cv in reversed(self._cv_stack):
            output = _parent_output(parent_cv, output.chaining_value(), _B3_IV, 0)
        return output.root_digest()


def new_blake3_hasher():
    if _native_blake3 is not None:
        return _native_blake3.blake3()
    return PureBlake3Hasher()


def blake3_digest(data: bytes) -> bytes:
    h = new_blake3_hasher()
    h.update(data)
    return h.digest()


# ---------------------------------------------------------------------------
# Protocol Constants & Data Model (SPEC.md)
# ---------------------------------------------------------------------------

DOMAIN_BLOB = b"git-b3-blob-v1\x00"
DOMAIN_TREE = b"git-b3-tree-v1\x00"
DOMAIN_COMMIT = b"git-b3-commit-v1\x00"
DOMAIN_LEGACY = b"git-b3-legacy-v1\x00"

HEADER_TREE = "blake3-tree"
HEADER_PARENT = "blake3-parent"
TAG_TRAILER_KEY = "Blake3-Object"

SHA1_HEX_RE = re.compile(r"^[0-9a-f]{40}$")
B3_HEX_RE = re.compile(r"^[0-9a-f]{64}$")
HEADER_PAIR_RE = re.compile(r"^([0-9a-f]{40}) ([0-9a-f]{64})$")


class GitB3Error(Exception):
    """Raised on Git errors, malformed headers, or verification failures."""


class VerificationError(GitB3Error):
    """Raised on cryptographic integrity mismatch or unsealed target."""


@dataclass(frozen=True)
class ParsedCommit:
    sha1: str
    raw: bytes
    tree_sha1: str
    parent_sha1s: tuple[str, ...]
    status: str  # "sealed" | "legacy" | "stale"
    expected_tree_b3: bytes | None
    expected_parent_b3s: tuple[bytes, ...] | None
    has_gpgsig: bool


# ---------------------------------------------------------------------------
# Git Repository Abstraction (subprocesses + injectable object reader for tests)
# ---------------------------------------------------------------------------

class GitRepo:
    def __init__(
        self,
        cwd: str | Path | None = None,
        object_reader: Callable[[str], tuple[str, bytes]] | None = None,
    ) -> None:
        self.cwd = str(cwd) if cwd is not None else os.getcwd()
        self._custom_reader = object_reader
        self._batch_proc: subprocess.Popen[bytes] | None = None

    def run_git(
        self,
        args: list[str],
        *,
        input_bytes: bytes | None = None,
        check: bool = True,
        env: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[bytes]:
        proc = subprocess.run(
            ["git", *args],
            cwd=self.cwd,
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
        )
        if check and proc.returncode != 0:
            err = proc.stderr.decode("utf-8", errors="replace").strip()
            raise GitB3Error(f"git {' '.join(args)} failed: {err}")
        return proc

    def git_dir(self) -> Path:
        out = self.run_git(["rev-parse", "--git-dir"]).stdout.decode().strip()
        p = Path(out)
        return p if p.is_absolute() else Path(self.cwd) / p

    def rev_parse(self, rev: str) -> str:
        return self.run_git(["rev-parse", "--verify", rev]).stdout.decode().strip()

    def try_rev_parse(self, rev: str) -> str | None:
        proc = self.run_git(["rev-parse", "--verify", "--quiet", rev], check=False)
        if proc.returncode != 0:
            return None
        return proc.stdout.decode().strip()

    def object_exists(self, oid: str) -> bool:
        if self._custom_reader is not None:
            try:
                self._custom_reader(oid)
                return True
            except KeyError:
                return False
        proc = self.run_git(["cat-file", "-e", oid], check=False)
        return proc.returncode == 0

    def _ensure_batch(self) -> subprocess.Popen[bytes]:
        if self._batch_proc is None or self._batch_proc.poll() is not None:
            self._batch_proc = subprocess.Popen(
                ["git", "cat-file", "--batch"],
                cwd=self.cwd,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
        return self._batch_proc

    def close(self) -> None:
        if self._batch_proc is not None:
            for stream in (
                self._batch_proc.stdin,
                self._batch_proc.stdout,
                self._batch_proc.stderr,
            ):
                if stream is not None:
                    try:
                        stream.close()
                    except OSError:
                        pass
            if self._batch_proc.poll() is None:
                self._batch_proc.wait()
        self._batch_proc = None

    def read_object(self, oid: str) -> tuple[str, bytes]:
        """Return (obj_type, raw_bytes) for an object OID."""
        if self._custom_reader is not None:
            return self._custom_reader(oid)
        proc = self._ensure_batch()
        assert proc.stdin is not None and proc.stdout is not None
        proc.stdin.write(f"{oid}\n".encode("ascii"))
        proc.stdin.flush()
        header = proc.stdout.readline()
        if not header:
            raise GitB3Error(f"git cat-file --batch closed unexpectedly on {oid}")
        parts = header.decode("ascii").strip().split()
        if len(parts) >= 2 and parts[1] == "missing":
            raise KeyError(f"missing git object: {oid}")
        if len(parts) != 3:
            raise GitB3Error(f"unexpected cat-file header: {header!r}")
        _, obj_type, size_str = parts
        size = int(size_str)
        data = b""
        while len(data) < size:
            chunk = proc.stdout.read(size - len(data))
            if not chunk:
                raise GitB3Error(f"truncated object body for {oid}")
            data += chunk
        lf = proc.stdout.read(1)
        if lf != b"\n":
            raise GitB3Error(f"missing trailing LF after object {oid}")
        return obj_type, data

    def shallow_commits(self) -> set[str]:
        shallow_file = self.git_dir() / "shallow"
        if not shallow_file.exists():
            return set()
        return {
            line.strip()
            for line in shallow_file.read_text(encoding="ascii").splitlines()
            if SHA1_HEX_RE.match(line.strip())
        }

    def get_config(self, key: str) -> str | None:
        proc = self.run_git(["config", "--get", key], check=False)
        if proc.returncode != 0:
            return None
        return proc.stdout.decode("utf-8", errors="replace").strip()

    def get_config_bool(self, key: str, default: bool = False) -> bool:
        proc = self.run_git(["config", "--bool", "--get", key], check=False)
        if proc.returncode != 0:
            return default
        return proc.stdout.decode().strip().lower() == "true"


# ---------------------------------------------------------------------------
# Commit & Tree Parsing + BLAKE3 Merkle Computation
# ---------------------------------------------------------------------------

def parse_git_tree(raw: bytes) -> list[tuple[bytes, bytes, bytes]]:
    """Parse raw Git tree object bytes into [(mode_bytes, name_bytes, sha1_20bytes)]."""
    entries: list[tuple[bytes, bytes, bytes]] = []
    i = 0
    n = len(raw)
    while i < n:
        sp = raw.find(b" ", i)
        if sp == -1:
            raise GitB3Error("malformed tree object: missing space")
        mode = raw[i:sp]
        nul = raw.find(b"\x00", sp + 1)
        if nul == -1 or nul + 21 > n:
            raise GitB3Error("malformed tree object: truncated entry")
        name = raw[sp + 1 : nul]
        oid_bytes = raw[nul + 1 : nul + 21]
        entries.append((mode, name, oid_bytes))
        i = nul + 21
    return entries


def split_commit_headers_body(raw: bytes) -> tuple[bytes, bytes]:
    idx = raw.find(b"\n\n")
    if idx == -1:
        return raw, b""
    return raw[:idx], raw[idx + 2 :]


def parse_commit_object(sha1: str, raw: bytes) -> ParsedCommit:
    """Parse a Git commit object and classify it as sealed, legacy, or stale."""
    header_bytes, _ = split_commit_headers_body(raw)
    header_text = header_bytes.decode("utf-8", errors="surrogateescape")

    tree_sha1: str | None = None
    parents: list[str] = []
    b3_trees: list[tuple[str, bytes]] = []
    b3_parents: list[tuple[str, bytes]] = []
    has_gpgsig = False

    for line in header_text.split("\n"):
        if not line or line.startswith(" "):
            # Continuation line of multi-line header (e.g. gpgsig, mergetag)
            continue
        if line.startswith("tree "):
            val = line[5:]
            if not SHA1_HEX_RE.match(val):
                raise GitB3Error(f"commit {sha1}: invalid tree OID {val!r}")
            tree_sha1 = val
        elif line.startswith("parent "):
            val = line[7:]
            if not SHA1_HEX_RE.match(val):
                raise GitB3Error(f"commit {sha1}: invalid parent OID {val!r}")
            parents.append(val)
        elif line.startswith("gpgsig ") or line.startswith("gpgsig-sha256 "):
            has_gpgsig = True
        elif line.startswith(f"{HEADER_TREE} "):
            val = line[len(HEADER_TREE) + 1 :]
            m = HEADER_PAIR_RE.match(val)
            if not m:
                raise VerificationError(
                    f"commit {sha1}: malformed {HEADER_TREE} header: {val!r}"
                )
            b3_trees.append((m.group(1), bytes.fromhex(m.group(2))))
        elif line.startswith(f"{HEADER_PARENT} "):
            val = line[len(HEADER_PARENT) + 1 :]
            m = HEADER_PAIR_RE.match(val)
            if not m:
                raise VerificationError(
                    f"commit {sha1}: malformed {HEADER_PARENT} header: {val!r}"
                )
            b3_parents.append((m.group(1), bytes.fromhex(m.group(2))))
        elif line == HEADER_TREE or line == HEADER_PARENT:
            raise VerificationError(f"commit {sha1}: empty {line} header")

    if tree_sha1 is None:
        raise GitB3Error(f"commit {sha1}: missing tree header")

    if len(b3_trees) > 1:
        raise VerificationError(f"commit {sha1}: duplicate {HEADER_TREE} headers")

    if len(b3_trees) == 0:
        if len(b3_parents) > 0:
            raise VerificationError(
                f"commit {sha1}: has {HEADER_PARENT} without {HEADER_TREE}"
            )
        return ParsedCommit(
            sha1=sha1,
            raw=raw,
            tree_sha1=tree_sha1,
            parent_sha1s=tuple(parents),
            status="legacy",
            expected_tree_b3=None,
            expected_parent_b3s=None,
            has_gpgsig=has_gpgsig,
        )

    ht_sha1, ht_b3 = b3_trees[0]
    parents_match = (
        len(b3_parents) == len(parents)
        and all(bp_sha1 == p_sha1 for (bp_sha1, _), p_sha1 in zip(b3_parents, parents))
    )
    if ht_sha1 == tree_sha1 and parents_match:
        return ParsedCommit(
            sha1=sha1,
            raw=raw,
            tree_sha1=tree_sha1,
            parent_sha1s=tuple(parents),
            status="sealed",
            expected_tree_b3=ht_b3,
            expected_parent_b3s=tuple(bp_b3 for _, bp_b3 in b3_parents),
            has_gpgsig=has_gpgsig,
        )

    # Header SHA-1s do not match current tree/parents (e.g., stock `git commit --amend`)
    return ParsedCommit(
        sha1=sha1,
        raw=raw,
        tree_sha1=tree_sha1,
        parent_sha1s=tuple(parents),
        status="stale",
        expected_tree_b3=None,
        expected_parent_b3s=None,
        has_gpgsig=has_gpgsig,
    )


class Blake3Calculator:
    """Computes B3Blob, B3Tree, and B3Commit over a GitRepo with in-memory memoization.

    IMPORTANT: Optional disk caching (`.git/b3-cache.json`) is ONLY enabled for
    commit/tag creation, NEVER during `verify`!
    """

    def __init__(self, repo: GitRepo, *, use_disk_cache: bool = False) -> None:
        self.repo = repo
        self.use_disk_cache = use_disk_cache
        self.blob_cache: dict[str, bytes] = {}
        self.tree_cache: dict[str, bytes] = {}
        self.commit_cache: dict[str, bytes] = {}
        self.parsed_commits: dict[str, ParsedCommit] = {}
        self._cache_path: Path | None = None
        if use_disk_cache:
            self._cache_path = repo.git_dir() / "b3-cache.json"
            self._load_disk_cache()

    def _load_disk_cache(self) -> None:
        if self._cache_path is None or not self._cache_path.exists():
            return
        try:
            data = json.loads(self._cache_path.read_text(encoding="ascii"))
            if data.get("version") != 1:
                return
            for k, v in data.get("blobs", {}).items():
                self.blob_cache[k] = bytes.fromhex(v)
            for k, v in data.get("trees", {}).items():
                self.tree_cache[k] = bytes.fromhex(v)
            for k, v in data.get("commits", {}).items():
                self.commit_cache[k] = bytes.fromhex(v)
        except (OSError, ValueError, TypeError):
            pass

    def save_disk_cache(self) -> None:
        if self._cache_path is None:
            return
        payload = {
            "version": 1,
            "blobs": {k: v.hex() for k, v in self.blob_cache.items()},
            "trees": {k: v.hex() for k, v in self.tree_cache.items()},
            "commits": {k: v.hex() for k, v in self.commit_cache.items()},
        }
        tmp = self._cache_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, separators=(",", ":")), encoding="ascii")
        os.replace(tmp, self._cache_path)

    def get_parsed_commit(self, sha1: str) -> ParsedCommit:
        cached = self.parsed_commits.get(sha1)
        if cached is not None:
            return cached
        obj_type, raw = self.repo.read_object(sha1)
        if obj_type != "commit":
            raise GitB3Error(f"expected commit object for {sha1}, got {obj_type}")
        parsed = parse_commit_object(sha1, raw)
        self.parsed_commits[sha1] = parsed
        return parsed

    def b3_blob(self, sha1: str) -> bytes:
        cached = self.blob_cache.get(sha1)
        if cached is not None:
            return cached
        obj_type, raw = self.repo.read_object(sha1)
        if obj_type != "blob":
            raise VerificationError(f"expected blob for {sha1}, got {obj_type}")
        h = new_blake3_hasher()
        h.update(DOMAIN_BLOB)
        h.update(raw)
        digest = h.digest()
        self.blob_cache[sha1] = digest
        return digest

    def b3_tree(self, sha1: str) -> bytes:
        cached = self.tree_cache.get(sha1)
        if cached is not None:
            return cached
        obj_type, raw = self.repo.read_object(sha1)
        if obj_type != "tree":
            raise VerificationError(f"expected tree for {sha1}, got {obj_type}")
        entries = parse_git_tree(raw)
        h = new_blake3_hasher()
        h.update(DOMAIN_TREE)
        for mode, name, child_oid_bytes in entries:
            child_sha1 = child_oid_bytes.hex()
            if mode == b"40000":
                child_hash = self.b3_tree(child_sha1)
            elif mode == b"160000":
                # Gitlink (submodule): hash raw 20-byte SHA-1 so tree verification
                # does not require cloning external submodules.
                child_hash = child_oid_bytes
            else:
                child_hash = self.b3_blob(child_sha1)
            h.update(mode)
            h.update(b" ")
            h.update(name)
            h.update(b"\x00")
            h.update(child_hash)
        digest = h.digest()
        self.tree_cache[sha1] = digest
        return digest

    def b3_commit(self, sha1: str, *, allow_shallow_stop: bool = False) -> tuple[bytes, list[str]]:
        """Compute B3Commit(sha1).

        Returns (digest_32bytes, sealed_ancestors_discovered_under_legacy_chain).
        Uses an explicit iterative post-order stack so deeply nested legacy histories
        never hit Python's recursion limit.
        """
        discovered_sealed: list[str] = []
        if sha1 in self.commit_cache:
            return self.commit_cache[sha1], discovered_sealed

        # Iterative post-order traversal for legacy chains
        stack: list[tuple[str, bool]] = [(sha1, False)]
        in_progress: set[str] = set()

        while stack:
            cur, expanded = stack.pop()
            if cur in self.commit_cache:
                continue
            pc = self.get_parsed_commit(cur)
            if pc.status == "sealed":
                h = new_blake3_hasher()
                h.update(DOMAIN_COMMIT)
                h.update(pc.raw)
                self.commit_cache[cur] = h.digest()
                if cur != sha1:
                    discovered_sealed.append(cur)
                continue

            if not expanded:
                if cur in in_progress:
                    raise VerificationError(f"cycle detected in commit graph at {cur}")
                in_progress.add(cur)
                stack.append((cur, True))
                for p in reversed(pc.parent_sha1s):
                    if p not in self.commit_cache:
                        if not self.repo.object_exists(p):
                            raise VerificationError(
                                f"missing legacy parent {p} of unsealed commit {cur} "
                                "(shallow boundary cuts through unsealed legacy history)"
                            )
                        stack.append((p, False))
            else:
                in_progress.discard(cur)
                tree_b3 = self.b3_tree(pc.tree_sha1)
                h = new_blake3_hasher()
                h.update(DOMAIN_LEGACY)
                h.update(struct.pack("<Q", len(pc.raw)))
                h.update(pc.raw)
                h.update(tree_b3)
                h.update(struct.pack("<I", len(pc.parent_sha1s)))
                for p in pc.parent_sha1s:
                    h.update(self.commit_cache[p])
                self.commit_cache[cur] = h.digest()

        return self.commit_cache[sha1], discovered_sealed


# ---------------------------------------------------------------------------
# Signing Helper (SSH & OpenPGP, compatible with stock `git verify-commit/tag`)
# ---------------------------------------------------------------------------

def sign_git_payload(repo: GitRepo, payload: bytes, signing_key: str | None = None) -> bytes:
    """Sign a Git commit or tag payload using the repository's configured signing format."""
    fmt = (repo.get_config("gpg.format") or "openpgp").lower()
    key = signing_key or repo.get_config("user.signingkey")

    if fmt == "ssh":
        if not key:
            raise GitB3Error("gpg.format=ssh requires user.signingkey (or -S <key>)")
        key_path = os.path.expanduser(key)
        with tempfile.TemporaryDirectory() as td:
            payload_file = Path(td) / "payload"
            payload_file.write_bytes(payload)
            proc = subprocess.run(
                ["ssh-keygen", "-Y", "sign", "-n", "git", "-f", key_path, str(payload_file)],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if proc.returncode != 0:
                raise GitB3Error(
                    f"ssh-keygen sign failed: {proc.stderr.decode(errors='replace').strip()}"
                )
            sig = Path(f"{payload_file}.sig").read_bytes()
            return sig.rstrip(b"\n")

    if fmt == "openpgp":
        gpg_prog = repo.get_config("gpg.program") or "gpg"
        cmd = [gpg_prog, "--status-fd=2", "-bsa"]
        if key:
            cmd.extend(["-u", key])
        proc = subprocess.run(cmd, input=payload, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if proc.returncode != 0:
            raise GitB3Error(
                f"{gpg_prog} sign failed: {proc.stderr.decode(errors='replace').strip()}"
            )
        return proc.stdout.rstrip(b"\n")

    raise GitB3Error(f"unsupported gpg.format: {fmt!r} (supported: ssh, openpgp)")


def format_gpgsig_header(sig_bytes: bytes) -> bytes:
    lines = sig_bytes.split(b"\n")
    out = [b"gpgsig " + lines[0]]
    for line in lines[1:]:
        out.append(b" " + line)
    return b"\n".join(out) + b"\n"


# ---------------------------------------------------------------------------
# Commit & Tag Creation
# ---------------------------------------------------------------------------

def strip_b3_and_sig_headers(header_bytes: bytes) -> list[bytes]:
    """Return non-blake3, non-gpgsig header lines from a commit header block."""
    kept: list[bytes] = []
    skip_cont = False
    for line in header_bytes.split(b"\n"):
        if line.startswith(b" "):
            if not skip_cont:
                kept.append(line)
            continue
        skip_cont = False
        if (
            line.startswith(b"gpgsig ")
            or line.startswith(b"gpgsig-sha256 ")
            or line.startswith(f"{HEADER_TREE} ".encode())
            or line.startswith(f"{HEADER_PARENT} ".encode())
        ):
            skip_cont = True
            continue
        kept.append(line)
    return kept


def build_sealed_commit_bytes(
    repo: GitRepo,
    calc: Blake3Calculator,
    base_header_lines: list[bytes],
    body_bytes: bytes,
    tree_sha1: str,
    parent_sha1s: list[str],
    *,
    sign: bool = False,
    signing_key: str | None = None,
) -> tuple[bytes, bytes, bytes]:
    """Build raw commit bytes with smuggled blake3-tree and blake3-parent headers.

    Returns (commit_raw, tree_b3, commit_b3).
    """
    tree_b3 = calc.b3_tree(tree_sha1)
    parent_b3s: list[tuple[str, bytes]] = []
    for p in parent_sha1s:
        pb3, _ = calc.b3_commit(p)
        parent_b3s.append((p, pb3))

    lines = list(base_header_lines)
    lines.append(f"{HEADER_TREE} {tree_sha1} {tree_b3.hex()}".encode("ascii"))
    for p_sha1, p_b3 in parent_b3s:
        lines.append(f"{HEADER_PARENT} {p_sha1} {p_b3.hex()}".encode("ascii"))

    unsigned_payload = b"\n".join(lines) + b"\n\n" + body_bytes

    if sign:
        sig = sign_git_payload(repo, unsigned_payload, signing_key=signing_key)
        raw = b"\n".join(lines) + b"\n" + format_gpgsig_header(sig) + b"\n" + body_bytes
    else:
        raw = unsigned_payload

    h = new_blake3_hasher()
    h.update(DOMAIN_COMMIT)
    h.update(raw)
    commit_b3 = h.digest()
    return raw, tree_b3, commit_b3


def current_git_ident(repo: GitRepo, role: str) -> str:
    """Ask Git for the exact author or committer ident line (`Name <email> ts tz`)."""
    var = "GIT_AUTHOR_IDENT" if role == "author" else "GIT_COMMITTER_IDENT"
    return repo.run_git(["var", var]).stdout.decode("utf-8").strip()


def cmd_commit(repo: GitRepo, args: argparse.Namespace) -> int:
    if args.all:
        repo.run_git(["add", "-u"])

    tree_sha1 = repo.run_git(["write-tree"]).stdout.decode().strip()

    head_sha1 = repo.try_rev_parse("HEAD")
    parents: list[str] = []
    if head_sha1 is not None:
        if not args.allow_empty:
            head_tree = repo.run_git(["rev-parse", "HEAD^{tree}"]).stdout.decode().strip()
            merge_head_file = repo.git_dir() / "MERGE_HEAD"
            if tree_sha1 == head_tree and not merge_head_file.exists():
                raise GitB3Error("nothing to commit (use --allow-empty to force)")
        parents.append(head_sha1)

    merge_head_file = repo.git_dir() / "MERGE_HEAD"
    if merge_head_file.exists():
        for line in merge_head_file.read_text(encoding="ascii").splitlines():
            oid = line.strip()
            if oid:
                parents.append(oid)

    if args.message is not None:
        msg = args.message
        if not msg.endswith("\n"):
            msg += "\n"
    elif (repo.git_dir() / "MERGE_MSG").exists():
        msg = (repo.git_dir() / "MERGE_MSG").read_text(encoding="utf-8")
        if not msg.endswith("\n"):
            msg += "\n"
    else:
        raise GitB3Error("commit message required via -m <message>")

    author = current_git_ident(repo, "author")
    committer = current_git_ident(repo, "committer")

    header_lines: list[bytes] = [f"tree {tree_sha1}".encode("ascii")]
    for p in parents:
        header_lines.append(f"parent {p}".encode("ascii"))
    header_lines.append(f"author {author}".encode("utf-8"))
    header_lines.append(f"committer {committer}".encode("utf-8"))

    want_sign = (
        bool(args.gpg_sign is not None)
        or (not args.no_gpg_sign and repo.get_config_bool("commit.gpgsign", False))
    )
    signing_key = args.gpg_sign if isinstance(args.gpg_sign, str) and args.gpg_sign else None

    calc = Blake3Calculator(repo, use_disk_cache=True)
    raw, tree_b3, commit_b3 = build_sealed_commit_bytes(
        repo,
        calc,
        header_lines,
        msg.encode("utf-8"),
        tree_sha1,
        parents,
        sign=want_sign,
        signing_key=signing_key,
    )

    new_sha1 = repo.run_git(
        ["hash-object", "-t", "commit", "-w", "--stdin"], input_bytes=raw
    ).stdout.decode().strip()

    first_line = msg.splitlines()[0] if msg.splitlines() else ""
    reflog_msg = f"commit (git-b3): {first_line}"
    if head_sha1 is None:
        # Unborn branch: update symbolic HEAD target directly
        head_ref = repo.run_git(["symbolic-ref", "HEAD"]).stdout.decode().strip()
        repo.run_git(["update-ref", "-m", reflog_msg, head_ref, new_sha1])
    else:
        repo.run_git(["update-ref", "-m", reflog_msg, "HEAD", new_sha1, head_sha1])

    # Clear merge state if we just completed a merge
    for mf in ("MERGE_HEAD", "MERGE_MSG", "MERGE_MODE"):
        p = repo.git_dir() / mf
        if p.exists():
            p.unlink()

    calc.commit_cache[new_sha1] = commit_b3
    calc.save_disk_cache()

    print(f"commit {new_sha1}")
    print(f"blake3-commit {commit_b3.hex()}")
    print(f"blake3-tree   {tree_b3.hex()}")
    if want_sign:
        print("signed        yes")
    return 0


def cmd_seal_head(repo: GitRepo, args: argparse.Namespace) -> int:
    """Idempotently seal HEAD (injecting blake3-tree & blake3-parent) in place.

    Ideal for use from a `.git/hooks/post-commit` hook.
    """
    head_sha1 = repo.rev_parse("HEAD")
    calc = Blake3Calculator(repo, use_disk_cache=True)
    pc = calc.get_parsed_commit(head_sha1)

    if pc.status == "sealed":
        # Verify the existing seal actually matches before returning early
        if hmac.compare_digest(calc.b3_tree(pc.tree_sha1), pc.expected_tree_b3 or b""):
            return 0

    header_bytes, body_bytes = split_commit_headers_body(pc.raw)
    base_lines = strip_b3_and_sig_headers(header_bytes)

    want_sign = (
        args.sign
        or pc.has_gpgsig
        or repo.get_config_bool("commit.gpgsign", False)
    )
    raw, tree_b3, commit_b3 = build_sealed_commit_bytes(
        repo,
        calc,
        base_lines,
        body_bytes,
        pc.tree_sha1,
        list(pc.parent_sha1s),
        sign=want_sign,
    )
    new_sha1 = repo.run_git(
        ["hash-object", "-t", "commit", "-w", "--stdin"], input_bytes=raw
    ).stdout.decode().strip()

    repo.run_git(["update-ref", "-m", "git-b3: seal HEAD", "HEAD", new_sha1, head_sha1])
    calc.commit_cache[new_sha1] = commit_b3
    calc.save_disk_cache()

    if not args.quiet:
        print(f"sealed {head_sha1[:12]} -> {new_sha1[:12]} (b3: {commit_b3.hex()[:16]}...)")
    return 0


def cmd_tag(repo: GitRepo, args: argparse.Namespace) -> int:
    target_sha1 = repo.rev_parse(args.target)
    obj_type, _ = repo.read_object(target_sha1)

    calc = Blake3Calculator(repo, use_disk_cache=True)
    if obj_type == "commit":
        target_b3, _ = calc.b3_commit(target_sha1)
    elif obj_type == "tree":
        target_b3 = calc.b3_tree(target_sha1)
    elif obj_type == "blob":
        target_b3 = calc.b3_blob(target_sha1)
    else:
        raise GitB3Error(f"cannot tag object type {obj_type!r}")

    tagger = current_git_ident(repo, "committer")
    msg = args.message.rstrip("\n")
    trailer = f"{TAG_TRAILER_KEY}: {target_sha1} {target_b3.hex()}"
    body = f"{msg}\n\n{trailer}\n" if msg else f"{trailer}\n"

    tag_payload = (
        f"object {target_sha1}\n"
        f"type {obj_type}\n"
        f"tag {args.name}\n"
        f"tagger {tagger}\n"
        f"\n"
        f"{body}"
    ).encode("utf-8")

    want_sign = (
        args.sign
        or (not args.no_sign and repo.get_config_bool("tag.gpgSign", False))
    )
    if want_sign:
        sig = sign_git_payload(repo, tag_payload, signing_key=args.local_user)
        full_tag = tag_payload + sig + b"\n"
    else:
        full_tag = tag_payload

    # `git mktag` validates the tag object strictly with Git's own fsck_tag rules!
    tag_sha1 = repo.run_git(["mktag"], input_bytes=full_tag).stdout.decode().strip()
    ref = f"refs/tags/{args.name}"
    if not args.force and repo.try_rev_parse(ref) is not None:
        raise GitB3Error(f"tag {args.name!r} already exists (use -f to overwrite)")
    repo.run_git(["update-ref", ref, tag_sha1])
    calc.save_disk_cache()

    print(f"tag {args.name} -> {tag_sha1}")
    print(f"target        {target_sha1} ({obj_type})")
    print(f"blake3-object {target_b3.hex()}")
    if want_sign:
        print("signed        yes")
    return 0


# ---------------------------------------------------------------------------
# Verification (NEVER trusts on-disk cache; hashes raw Git objects directly!)
# ---------------------------------------------------------------------------

def parse_tag_b3_trailer(tag_raw: bytes) -> tuple[str, str, bytes | None]:
    """Return (target_sha1, target_type, expected_target_b3_or_none) from an annotated tag."""
    header_bytes, body_bytes = split_commit_headers_body(tag_raw)
    target_sha1: str | None = None
    target_type: str | None = None
    for line in header_bytes.decode("utf-8", errors="surrogateescape").split("\n"):
        if line.startswith("object "):
            target_sha1 = line[7:]
        elif line.startswith("type "):
            target_type = line[5:]
    if not target_sha1 or not target_type:
        raise VerificationError("malformed tag object: missing object or type")

    # Strip trailing PGP/SSH signature block if present
    body_text = body_bytes.decode("utf-8", errors="surrogateescape")
    for marker in ("-----BEGIN PGP SIGNATURE-----", "-----BEGIN SSH SIGNATURE-----"):
        pos = body_text.find(marker)
        if pos != -1:
            body_text = body_text[:pos]
            break

    found: list[tuple[str, bytes]] = []
    prefix = f"{TAG_TRAILER_KEY}: "
    for line in body_text.splitlines():
        if line.startswith(prefix):
            val = line[len(prefix) :].strip()
            m = HEADER_PAIR_RE.match(val)
            if not m:
                raise VerificationError(f"malformed {TAG_TRAILER_KEY} trailer: {val!r}")
            found.append((m.group(1), bytes.fromhex(m.group(2))))

    if len(found) > 1:
        raise VerificationError(f"duplicate {TAG_TRAILER_KEY} trailers in tag")
    if len(found) == 0:
        return target_sha1, target_type, None
    t_sha1, t_b3 = found[0]
    if t_sha1 != target_sha1:
        raise VerificationError(
            f"tag {TAG_TRAILER_KEY} target SHA-1 ({t_sha1}) != tag object ({target_sha1})"
        )
    return target_sha1, target_type, t_b3


@dataclass
class VerifyResult:
    target_sha1: str
    target_b3: bytes
    sealed_commits: int
    legacy_commits: int
    shallow_boundaries: int
    signature_verified: bool


def verify_repo(
    repo: GitRepo,
    rev: str = "HEAD",
    *,
    expect_b3_hex: str | None = None,
    require_signature: bool = False,
    allow_shallow: bool = True,
) -> VerifyResult:
    """Verify full BLAKE3 Merkle integrity starting at `rev`."""
    oid = repo.rev_parse(rev)
    obj_type, raw = repo.read_object(oid)

    expect_b3: bytes | None = None
    if expect_b3_hex is not None:
        if not B3_HEX_RE.match(expect_b3_hex):
            raise VerificationError(f"invalid --expect blake3 hex: {expect_b3_hex!r}")
        expect_b3 = bytes.fromhex(expect_b3_hex)

    sig_verified = False

    # Handle annotated tag targets
    if obj_type == "tag":
        target_sha1, target_type, tag_b3 = parse_tag_b3_trailer(raw)
        if tag_b3 is None:
            raise VerificationError(f"tag {rev} ({oid}) has no {TAG_TRAILER_KEY} trailer")
        if require_signature:
            repo.run_git(["verify-tag", oid])
            sig_verified = True
        if expect_b3 is not None and not hmac.compare_digest(expect_b3, tag_b3):
            raise VerificationError(
                f"tag {TAG_TRAILER_KEY} ({tag_b3.hex()}) does not match --expect ({expect_b3.hex()})"
            )
        expect_b3 = tag_b3
        oid = target_sha1
        obj_type = target_type

    if obj_type != "commit":
        # Direct blob/tree tag verification
        calc = Blake3Calculator(repo, use_disk_cache=False)
        actual = calc.b3_tree(oid) if obj_type == "tree" else calc.b3_blob(oid)
        if expect_b3 is None or not hmac.compare_digest(actual, expect_b3):
            raise VerificationError(f"{obj_type} {oid} BLAKE3 mismatch")
        return VerifyResult(oid, actual, 0, 0, 0, sig_verified)

    # Fresh calculator with NO disk cache!
    calc = Blake3Calculator(repo, use_disk_cache=False)
    shallow_set = repo.shallow_commits()

    root_pc = calc.get_parsed_commit(oid)
    if require_signature and not sig_verified:
        if root_pc.status != "sealed":
            raise VerificationError(
                f"commit {oid} is {root_pc.status}: a signature on an unsealed commit "
                "does not sign BLAKE3 hashes"
            )
        repo.run_git(["verify-commit", oid])
        sig_verified = True

    if root_pc.status != "sealed" and expect_b3 is None:
        raise VerificationError(
            f"commit {oid} is {root_pc.status} (no active {HEADER_TREE} header and no --expect)"
        )

    root_b3, initial_sealed = calc.b3_commit(oid)
    if expect_b3 is not None and not hmac.compare_digest(root_b3, expect_b3):
        raise VerificationError(
            f"commit {oid} BLAKE3 mismatch: expected {expect_b3.hex()}, got {root_b3.hex()}"
        )

    # Walk all reachable sealed commits & verify every tree and parent link!
    queue: deque[str] = deque()
    seen_sealed: set[str] = set()
    if root_pc.status == "sealed":
        queue.append(oid)
        seen_sealed.add(oid)
    for sc in initial_sealed:
        if sc not in seen_sealed:
            queue.append(sc)
            seen_sealed.add(sc)

    shallow_hits = 0

    while queue:
        cur = queue.popleft()
        pc = calc.get_parsed_commit(cur)
        assert pc.status == "sealed"
        assert pc.expected_tree_b3 is not None and pc.expected_parent_b3s is not None

        # 1. Verify entire tree (recursively over all subtrees and blobs)
        actual_tree_b3 = calc.b3_tree(pc.tree_sha1)
        if not hmac.compare_digest(actual_tree_b3, pc.expected_tree_b3):
            raise VerificationError(
                f"TREE CORRUPTION / SHA-1 COLLISION at commit {cur} (tree {pc.tree_sha1}):\n"
                f"  expected blake3-tree: {pc.expected_tree_b3.hex()}\n"
                f"  actual   blake3-tree: {actual_tree_b3.hex()}"
            )

        # 2. Verify every parent link
        for p_sha1, expected_p_b3 in zip(pc.parent_sha1s, pc.expected_parent_b3s):
            if not repo.object_exists(p_sha1):
                if allow_shallow and (cur in shallow_set or shallow_set):
                    shallow_hits += 1
                    continue
                raise VerificationError(
                    f"missing parent commit {p_sha1} of {cur} (pass --allow-shallow for shallow clones)"
                )
            actual_p_b3, discovered_sealed = calc.b3_commit(p_sha1)
            if not hmac.compare_digest(actual_p_b3, expected_p_b3):
                raise VerificationError(
                    f"HISTORY CORRUPTION / SHA-1 COLLISION at parent {p_sha1} of commit {cur}:\n"
                    f"  expected blake3-parent: {expected_p_b3.hex()}\n"
                    f"  actual   blake3-parent: {actual_p_b3.hex()}"
                )
            p_pc = calc.get_parsed_commit(p_sha1)
            if p_pc.status == "sealed" and p_sha1 not in seen_sealed:
                seen_sealed.add(p_sha1)
                queue.append(p_sha1)
            for sc in discovered_sealed:
                if sc not in seen_sealed:
                    seen_sealed.add(sc)
                    queue.append(sc)

    legacy_count = sum(1 for pc in calc.parsed_commits.values() if pc.status != "sealed")
    return VerifyResult(
        target_sha1=oid,
        target_b3=root_b3,
        sealed_commits=len(seen_sealed),
        legacy_commits=legacy_count,
        shallow_boundaries=shallow_hits,
        signature_verified=sig_verified,
    )


def cmd_verify(repo: GitRepo, args: argparse.Namespace) -> int:
    res = verify_repo(
        repo,
        args.rev,
        expect_b3_hex=args.expect,
        require_signature=args.require_signature,
        allow_shallow=not args.no_shallow,
    )
    print(f"VERIFIED {res.target_sha1}")
    print(f"  blake3-commit:      {res.target_b3.hex()}")
    print(f"  sealed commits:     {res.sealed_commits}")
    print(f"  legacy commits:     {res.legacy_commits} (retroactively sealed)")
    if res.shallow_boundaries:
        print(f"  shallow boundaries: {res.shallow_boundaries}")
    if res.signature_verified:
        print("  signature:          GOOD (covers blake3 headers/trailer)")
    return 0


def cmd_id(repo: GitRepo, args: argparse.Namespace) -> int:
    oid = repo.rev_parse(args.rev)
    obj_type, _ = repo.read_object(oid)
    calc = Blake3Calculator(repo, use_disk_cache=False)
    if obj_type == "commit":
        b3, _ = calc.b3_commit(oid)
    elif obj_type == "tree":
        b3 = calc.b3_tree(oid)
    elif obj_type == "blob":
        b3 = calc.b3_blob(oid)
    else:
        raise GitB3Error(f"unsupported object type: {obj_type}")
    print(b3.hex())
    return 0


def cmd_log(repo: GitRepo, args: argparse.Namespace) -> int:
    rev_args = ["rev-list", f"-n{args.count}", args.rev]
    oids = repo.run_git(rev_args).stdout.decode().splitlines()
    calc = Blake3Calculator(repo, use_disk_cache=False)
    for oid in oids:
        pc = calc.get_parsed_commit(oid)
        b3, _ = calc.b3_commit(oid)
        _, body = split_commit_headers_body(pc.raw)
        subj = body.decode("utf-8", errors="replace").splitlines()[0] if body else ""
        sig_tag = " [sig]" if pc.has_gpgsig else ""
        print(f"{oid[:12]}  b3:{b3.hex()[:16]}  [{pc.status:6s}]{sig_tag}  {subj}")
    return 0


def cmd_install_hook(repo: GitRepo, args: argparse.Namespace) -> int:
    hooks_dir = repo.git_dir() / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    hook_path = hooks_dir / "post-commit"
    if hook_path.exists() and not args.force:
        raise GitB3Error(f"{hook_path} already exists (use --force to overwrite)")
    script_path = Path(__file__).resolve()
    hook_content = (
        "#!/bin/sh\n"
        "# Installed by git-b3: transparently seals new local commits with BLAKE3 headers.\n"
        f'exec "{script_path}" seal-head --quiet\n'
    )
    hook_path.write_text(hook_content, encoding="utf-8")
    hook_path.chmod(hook_path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"Installed post-commit hook at {hook_path}")
    return 0


